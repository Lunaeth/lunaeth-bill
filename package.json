{
  "name": "lunaeth-bill",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "build:engine": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.app.json && vite build",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "privacy:check": "node scripts/privacy-check.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.1.0",
    "lucide-react": "^1.68.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
